---
import Base from '../../../layouts/Base.astro';
import courses from '../../../data/courses.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = (await import('../../../data/courses.json')).default;
  return all.map((c) => ({ params: { course: c.slug }, props: { course: c } }));
}

const { course } = Astro.props;

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .filter((n) => n.data.course === course.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const others = courses.filter((c) => c.slug !== course.slug);
// 시험 준비 자료(개념 지도, 모의시험)는 별도 사이트인 AI Study Hub 에 있다. 과목에 연결이 있으면 보여 준다.
const prep = 'prep' in course ? course.prep : null;
---

<Base
  activeNav="courses"
  title={`${course.name} · 최경찬`}
  description={course.desc}
>
  <div class="wrap">
    <header class="page-head">
      <a class="post-back" href="/공부">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        과목 목록
      </a>
      <div class="co-term">{course.term}</div>
      <h1>{course.name}</h1>
      <p class="page-lead">{course.desc}</p>
      <div class="co-topics-head">
        {course.topics.map((t) => <span class="chip">{t}</span>)}
      </div>
    </header>
  </div>

  {prep && (
    <section class="section co-section co-prep">
      <div class="wrap">
        <div class="sec-head reveal">
          <h2>시험 준비</h2>
        </div>
        <ul class="oth-list">
          <li>
            <a href={prep.url}>
              <strong>{prep.label}</strong>
              <span>{prep.desc}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  )}

  <section class="section co-section">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>노트 <span class="res-count">{notes.length}</span></h2>
        <p class="sec-note">
          {notes.length > 0
            ? '제목을 누르면 노트 전문으로 이동합니다. 수식은 미리 렌더돼 있어 따로 기다릴 필요가 없습니다.'
            : '아직 공개한 노트가 없습니다. 수업이 진행되면 정리한 순서대로 올립니다.'}
        </p>
      </div>

      {notes.length > 0 ? (
        <ul class="nt-list">
          {notes.map((n, i) => (
            <li class="nt-item reveal" style={`--d:${0.06 * (i + 1)}s`}>
              <div class="nt-main">
                <h3>
                  <a href={`/공부/${course.slug}/${n.id}`}>
                    {n.data.title} <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </h3>
                {n.data.summary && <p class="nt-summary">{n.data.summary}</p>}
                {n.data.scope && <div class="nt-scope">범위 · {n.data.scope}</div>}
              </div>
              <div class="nt-meta">
                <span class="chip">{n.data.kind}</span>
                <time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="nt-empty">
          다른 과목의 노트는 <a href="/공부">과목 목록</a>에서 볼 수 있습니다.
        </p>
      )}
    </div>
  </section>

  <section class="section co-other">
    <div class="wrap">
      <div class="sec-head reveal">
        <h2>다른 과목</h2>
      </div>
      <ul class="oth-list">
        {others.map((c) => (
          <li>
            <a href={`/공부/${c.slug}`}>
              <strong>{c.name}</strong>
              <span>{c.tagline}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 640;
    color: var(--muted);
    margin-bottom: var(--s4);
  }
  .post-back:hover { color: var(--accent); }

  .co-term {
    font-size: 0.82rem;
    font-weight: 680;
    color: var(--accent-strong);
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.5rem;
  }
  .co-topics-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--s5);
  }
  .co-topics-head .chip { background: var(--panel-2); }

  .co-section { padding-block: clamp(1rem, 2vw, 1.5rem) clamp(2rem, 4vw, 3rem); }
  .co-prep + .co-section { border-top: 0; }
  .co-prep .sec-head { margin-bottom: var(--s4); }
  .co-other { padding-block: 0 clamp(2.5rem, 5vw, 4rem); }

  .res-count {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted);
    vertical-align: 0.18em;
    margin-left: 0.15rem;
  }

  .nt-list { list-style: none; display: flex; flex-direction: column; gap: var(--s4); }
  .nt-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    padding: clamp(1.15rem, 2.4vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--r);
    background: var(--surface);
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .nt-item:hover {
    border-color: var(--border-strong);
    background: var(--panel);
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) { .nt-item:hover { transform: none; } }

  .nt-main { min-width: 0; }
  .nt-item h3 {
    font-size: clamp(1.12rem, 1.6vw, 1.35rem);
    font-weight: 760;
    letter-spacing: -0.02em;
    line-height: 1.3;
    word-break: keep-all;
  }
  .nt-item h3 a { color: var(--ink); display: inline; }
  .nt-item h3 a:hover { color: var(--accent); }
  .nt-item h3 .arrow {
    display: inline-block;
    color: var(--muted);
    transition: transform 0.25s var(--ease), color 0.25s var(--ease);
  }
  .nt-item:hover h3 .arrow { transform: translateX(4px); color: var(--accent); }

  .nt-summary {
    margin-top: var(--s3);
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.65;
    text-wrap: pretty;
    word-break: keep-all;
  }
  .nt-scope {
    margin-top: var(--s3);
    font-size: 0.82rem;
    font-weight: 620;
    color: var(--muted);
    word-break: keep-all;
  }

  .nt-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    align-self: start;
    padding-top: 0.2rem;
  }
  .nt-meta .chip { background: var(--accent-tint); color: var(--accent-strong); border-color: var(--accent-line); }
  .nt-meta time { font-family: var(--mono); font-size: 0.76rem; color: var(--muted); }

  .nt-empty { color: var(--ink-2); }

  .oth-list { list-style: none; display: flex; flex-direction: column; }
  .oth-list li + li { border-top: 1px solid var(--border); }
  .oth-list a {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: var(--s4) 0;
    color: var(--ink);
  }
  .oth-list strong { font-weight: 720; letter-spacing: -0.02em; white-space: nowrap; }
  .oth-list span:not(.arrow) {
    color: var(--ink-2);
    font-size: 0.9rem;
    min-width: 0;
    word-break: keep-all;
  }
  .oth-list .arrow { margin-left: auto; color: var(--muted); transition: transform 0.25s var(--ease), color 0.25s var(--ease); }
  .oth-list a:hover { color: var(--accent); }
  .oth-list a:hover .arrow { transform: translateX(4px); color: var(--accent); }

  @media (max-width: 760px) {
    .nt-item { grid-template-columns: 1fr; gap: var(--s3); }
    .nt-meta { flex-direction: row; align-items: center; justify-content: flex-start; }
    .oth-list a { flex-wrap: wrap; gap: 0.35rem 0.9rem; }
    .oth-list .arrow { margin-left: 0; }
  }
</style>
